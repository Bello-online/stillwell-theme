{%- comment -%}
  Perch stroke icons. 20 px, 1.75 stroke, currentColor.
  Usage: {% render 'icon-perch', icon: 'induction' %}
  Icons: induction, bluetooth, angle, light, battery, usb, bolt, ruler, weight, shield,
         speaker, phone, tablet, clock, palette, check, truck, return, box, sensor, magnet.
{%- endcomment -%}
{%- assign icon = icon | default: 'bolt' -%}
<svg class="perch-icon perch-icon--{{ icon }}" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
  {%- case icon -%}
    {%- when 'induction' -%}
      <rect x="9" y="3" width="8" height="14" rx="1.5"/>
      <path d="M13 14.5h.01"/>
      <path d="M5 9a6 6 0 0 0 0 6M2.5 6.5a9.5 9.5 0 0 0 0 11"/>
      <path d="M7 21h12"/>
    {%- when 'bluetooth' -%}
      <path d="m7 7 10 10-5 5V2l5 5L7 17"/>
    {%- when 'angle' -%}
      <path d="M4 20h16"/>
      <path d="M4 20 16 4"/>
      <path d="M10 20a7 7 0 0 0-2-5.2"/>
    {%- when 'light' -%}
      <path d="M12 3v2M5.6 5.6l1.4 1.4M3 12h2M19 12h2M18.4 5.6 17 7"/>
      <path d="M9 18h6M10 21h4"/>
      <path d="M8 14.5a5 5 0 1 1 8 0c-.8.9-1 1.5-1 2.5H9c0-1-.2-1.6-1-2.5Z"/>
    {%- when 'battery' -%}
      <rect x="2" y="7" width="17" height="10" rx="2"/>
      <path d="M22 10v4"/>
      <path d="M6 10.5v3M9.5 10.5v3M13 10.5v3"/>
    {%- when 'usb' -%}
      <rect x="3" y="9" width="18" height="6" rx="3"/>
      <path d="M7 12h10"/>
    {%- when 'bolt' -%}
      <path d="M13 2 4 14h7l-1 8 9-12h-7l1-8Z"/>
    {%- when 'ruler' -%}
      <path d="m3 17 14-14 4 4L7 21l-4-4Z"/>
      <path d="m7 13 1.5 1.5M10 10l1.5 1.5M13 7l1.5 1.5"/>
    {%- when 'weight' -%}
      <path d="M6 21h12a2 2 0 0 0 2-2.2L18.6 9.7A2 2 0 0 0 16.6 8H7.4a2 2 0 0 0-2 1.7L4 18.8A2 2 0 0 0 6 21Z"/>
      <circle cx="12" cy="5" r="2.5"/>
    {%- when 'shield' -%}
      <path d="M12 3 4 6v6c0 4.5 3.4 8 8 9 4.6-1 8-4.5 8-9V6l-8-3Z"/>
      <path d="m9 12 2 2 4-4"/>
    {%- when 'speaker' -%}
      <rect x="5" y="2" width="14" height="20" rx="2"/>
      <circle cx="12" cy="14" r="4"/>
      <circle cx="12" cy="6.5" r="1"/>
    {%- when 'phone' -%}
      <rect x="7" y="2" width="10" height="20" rx="2"/>
      <path d="M11 18h2"/>
    {%- when 'tablet' -%}
      <rect x="4" y="3" width="16" height="18" rx="2"/>
      <path d="M11 17.5h2"/>
    {%- when 'clock' -%}
      <circle cx="12" cy="12" r="9"/>
      <path d="M12 7v5l3 2"/>
    {%- when 'palette' -%}
      <path d="M12 21a9 9 0 1 1 9-9c0 2-1.5 3-3 3h-2a2 2 0 0 0 0 4c0 1-1 2-4 2Z"/>
      <circle cx="8" cy="10" r="1"/>
      <circle cx="12" cy="7" r="1"/>
      <circle cx="16" cy="10" r="1"/>
    {%- when 'check' -%}
      <circle cx="12" cy="12" r="9"/>
      <path d="m8 12 3 3 5-6"/>
    {%- when 'truck' -%}
      <path d="M3 7h11v9H3zM14 10h4l3 3v3h-7z"/>
      <circle cx="7" cy="18" r="1.8"/>
      <circle cx="17" cy="18" r="1.8"/>
    {%- when 'return' -%}
      <path d="M9 14 4 9l5-5"/>
      <path d="M4 9h10a6 6 0 0 1 0 12h-3"/>
    {%- when 'box' -%}
      <path d="m12 3 8 4.5v9L12 21l-8-4.5v-9L12 3Z"/>
      <path d="M4 7.5 12 12l8-4.5M12 12v9"/>
    {%- when 'sensor' -%}
      <circle cx="12" cy="12" r="2"/>
      <path d="M8.5 8.5a5 5 0 0 0 0 7M15.5 8.5a5 5 0 0 1 0 7M5.6 5.6a9 9 0 0 0 0 12.8M18.4 5.6a9 9 0 0 1 0 12.8"/>
    {%- when 'magnet' -%}
      <path d="M6 3v9a6 6 0 0 0 12 0V3"/>
      <path d="M10 3v9a2 2 0 0 0 4 0V3"/>
      <path d="M6 7h4M14 7h4"/>
    {%- else -%}
      <circle cx="12" cy="12" r="9"/>
  {%- endcase -%}
</svg>
