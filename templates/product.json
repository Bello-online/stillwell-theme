    "testimonials": {
      "type": "testimonials",
      "blocks": {
        "labels": {
          "type": "testimonial",
          "settings": {
            "rating": 5,
            "title": "Labels say what is inside",
            "quote": "<p>Every amount is listed. No blend with a total but no breakdown. That is the whole reason I switched, and the How to choose page saved me from buying things I did not need.</p>",
            "author": "Kwame A., Ottawa",
            "verified": true
          }
        },
        "returned": {
          "type": "testimonial",
          "settings": {
            "rating": 4,
            "title": "Returned one, kept the other",
            "quote": "<p>The protein was not for me, so I sent it back half used. Refund landed in about a week with no questions asked. Kept the creatine and have reordered it since.</p>",
            "author": "Sarah L., Vancouver",
            "verified": true
          }
        }
      },
      "block_order": [
        "labels",
        "returned"
      ],
      "settings": {
        "eyebrow": "From customers",
        "heading": "What people tell us",
        "heading_size": "h2",
        "subheading": "",
        "verified_label": "Verified order",
