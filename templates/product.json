{
  "sections": {
    "main": {
      "type": "main-product",
      "blocks": {
        "eyebrow": {
          "type": "text",
          "settings": {
            "text": "Third-party tested",
            "text_style": "uppercase"
          }
        },
        "title": {
          "type": "title"
        },
        "price": {
          "type": "price"
        },
        "variant_picker": {
          "type": "variant_picker",
          "settings": {
            "picker_type": "button",
            "swatch_shape": "none"
          }
        },
        "quantity_selector": {
          "type": "quantity_selector"
        },
        "buy_buttons": {
          "type": "buy_buttons",
          "settings": {
            "show_dynamic_checkout": true,
            "show_gift_card_recipient": false
          }
        },
        "reassurance": {
          "type": "icon-with-text",
          "settings": {
            "layout": "horizontal",
            "icon_1": "truck",
            "heading_1": "Free shipping over $60",
            "icon_2": "return",
            "heading_2": "30-day returns, even if opened",
            "icon_3": "check_mark",
            "heading_3": "Third-party tested"
          }
        },
        "description": {
          "type": "description"
        },
        "how-to-take": {
          "type": "collapsible_tab",
          "settings": {
            "heading": "How to take it",
            "icon": "none",
            "content": "<p>Follow the directions on the label. Most of our capsules are taken once a day with food; powders are mixed into water or a shake. If you take medication or are pregnant or breastfeeding, check with your pharmacist or doctor first.</p>",
            "page": ""
          }
        },
        "whats-in-it": {
          "type": "collapsible_tab",
          "settings": {
            "heading": "What's in it",
            "icon": "none",
            "content": "<p>Merchant: paste the full supplement facts here, including the form of each ingredient (for example, magnesium bisglycinate) and the amount per serving. Note allergens and whether the product is vegan and gluten-free.</p>",
            "page": ""
          }
        },
        "shipping-returns": {
          "type": "collapsible_tab",
          "settings": {
            "heading": "Shipping and returns",
            "icon": "none",
            "content": "<p>Free standard shipping on orders over $60; flat $9.95 below that. Orders ship from Canada and you will see the carrier's real delivery estimate at checkout.</p><p>Returns are accepted for 30 days, even if opened. We cover return shipping and there are no restocking fees.</p>",
            "page": ""
          }
        },
        "share": {
          "type": "share",
          "settings": {
            "share_label": "Share"
          }
        }
      },
      "block_order": [
        "eyebrow",
        "title",
        "price",
        "variant_picker",
        "quantity_selector",
        "buy_buttons",
        "reassurance",
        "description",
        "how-to-take",
        "whats-in-it",
        "shipping-returns",
        "share"
      ],
      "settings": {
        "enable_sticky_info": true,
        "color_scheme": "scheme-1",
        "media_position": "left",
        "gallery_layout": "stacked",
        "media_size": "medium",
        "constrain_to_viewport": true,
        "media_fit": "contain",
        "image_zoom": "lightbox",
        "mobile_thumbnails": "hide",
        "hide_variants": true,
        "enable_video_looping": false,
        "padding_top": 36,
        "padding_bottom": 24
      }
    },
    "related-products": {
      "type": "related-products",
      "settings": {
        "heading": "Often paired with this",
        "heading_size": "h2",
        "products_to_show": 4,
        "columns_desktop": 4,
        "color_scheme": "scheme-1",
        "image_ratio": "square",
        "image_shape": "default",
        "show_secondary_image": true,
        "show_vendor": false,
        "show_rating": false,
        "columns_mobile": "2",
        "padding_top": 40,
