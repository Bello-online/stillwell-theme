          "settings": {
            "heading": "Does it hold a tablet?",
            "icon": "none",
            "row_content": "<p>Yes. The foot folds out and the stand tilts to 75 degrees, which takes a full-size tablet in landscape. Open the foot fully for anything larger than a phone.</p>",
            "page": ""
          }
        },
