    "testimonials": {
      "type": "testimonials",
      "blocks": {
        "routine": {
          "type": "testimonial",
          "settings": {
            "rating": 5,
            "title": "The routine actually fits",
            "quote": "<p>I was taking six things before. Went through the How to choose page and ended up with two. Three months in, I have not missed a day, which is more than I could say for the old shelf of bottles.</p>",
            "author": "Priya S., Toronto",
            "verified": true
          }
        },
        "delivery": {
          "type": "testimonial",
          "settings": {
            "rating": 4,
            "title": "Delivery estimate was accurate",
            "quote": "<p>Ordered Sunday night. The confirmation said Wednesday to Friday and it came Thursday. Plain packaging, sealed tub. Four stars only because I wish the electrolyte powder came in a bigger size.</p>",
            "author": "Marc D., Halifax",
            "verified": true
          }
        },
        "answers": {
          "type": "testimonial",
          "settings": {
            "rating": 5,
            "title": "Answers without the sales pitch",
            "quote": "<p>I emailed asking whether the adaptogen complex would overlap with my multivitamin. Got a straight answer the next morning, including a suggestion to check with my pharmacist about a medication I take. Did not expect that from a supplement company.</p>",
            "author": "Janelle R., Calgary",
            "verified": true
          }
        }
      },
