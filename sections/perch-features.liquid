{{ 'section-perch-features.css' | asset_url | stylesheet_tag }}

{%- style -%}
  .section-{{ section.id }}-padding { padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px; padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px; }
  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding { padding-top: {{ section.settings.padding_top }}px; padding-bottom: {{ section.settings.padding_bottom }}px; }
  }
{%- endstyle -%}

<div class="perch-features color-{{ section.settings.color_scheme }} gradient"{% if section.settings.anchor != blank %} id="{{ section.settings.anchor | handleize }}"{% endif %}>
  <div class="page-width section-{{ section.id }}-padding">
    {%- if section.settings.eyebrow != blank or section.settings.heading != blank or section.settings.subheading != blank -%}
      <div class="perch-features__header">
        {%- if section.settings.eyebrow != blank -%}
          <p class="perch-features__eyebrow">{{ section.settings.eyebrow | escape }}</p>
        {%- endif -%}
        {%- if section.settings.heading != blank -%}
          <h2 class="perch-features__heading h1">{{ section.settings.heading | escape }}</h2>
        {%- endif -%}
        {%- if section.settings.subheading != blank -%}
          <div class="perch-features__subheading rte">{{ section.settings.subheading }}</div>
        {%- endif -%}
      </div>
    {%- endif -%}

    <ol class="perch-features__grid perch-features__grid--{{ section.settings.columns }} list-unstyled" role="list">
      {%- for block in section.blocks -%}
        <li class="perch-features__card color-{{ section.settings.card_color_scheme }} gradient" {{ block.shopify_attributes }}>
          <div class="perch-features__top">
            <span class="perch-features__icon" aria-hidden="true">{% render 'icon-perch', icon: block.settings.icon %}</span>
            {%- if section.settings.show_numbers -%}
              <span class="perch-features__number" aria-hidden="true">{{ forloop.index | prepend: '0' | slice: -2, 2 }}</span>
            {%- endif -%}
          </div>
          {%- if block.settings.heading != blank -%}
            <h3 class="perch-features__title">{{ block.settings.heading | escape }}</h3>
          {%- endif -%}
          {%- if block.settings.text != blank -%}
            <p class="perch-features__text">{{ block.settings.text | escape }}</p>
          {%- endif -%}
          {%- if block.settings.detail != blank -%}
            <p class="perch-features__detail">{{ block.settings.detail | escape }}</p>
          {%- endif -%}
        </li>
      {%- endfor -%}
    </ol>
  </div>
</div>

{% schema %}
{
  "name": "Perch features",
  "tag": "section",
  "class": "section section-perch-features",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "max_blocks": 8,
  "settings": [
    {
      "type": "text",
      "id": "anchor",
      "label": "Anchor id",
      "info": "Lets a button link to this section, for example /#how-it-works.",
      "default": "how-it-works"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "How it works"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "One stand. Four jobs."
    },
    {
      "type": "richtext",
      "id": "subheading",
      "label": "Subheading"
    },
    {
      "type": "range",
      "id": "columns",
      "min": 2,
      "max": 4,
      "step": 1,
      "label": "Columns on desktop",
      "default": 4
    },
    {
      "type": "checkbox",
      "id": "show_numbers",
      "label": "Show step numbers",
      "default": true
    },
    {
      "type": "header",
      "content": "Colour and spacing"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.colors.label",
      "default": "scheme-1"
    },
    {
      "type": "color_scheme",
      "id": "card_color_scheme",
      "label": "Card colour scheme",
      "default": "scheme-2"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 64
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 64
    }
  ],
  "blocks": [
    {
      "type": "feature",
      "name": "Feature",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "default": "induction",
          "options": [
            { "value": "induction", "label": "Induction" },
            { "value": "bluetooth", "label": "Bluetooth" },
            { "value": "angle", "label": "Angle" },
            { "value": "light", "label": "Light" },
            { "value": "battery", "label": "Battery" },
            { "value": "usb", "label": "USB" },
            { "value": "speaker", "label": "Speaker" },
            { "value": "phone", "label": "Phone" },
            { "value": "tablet", "label": "Tablet" },
            { "value": "bolt", "label": "Bolt" },
            { "value": "shield", "label": "Shield" },
            { "value": "clock", "label": "Clock" }
          ]
        },
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "Induction mode"
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "Text",
          "default": "Rest your phone against the pad with its speaker facing down. The audio plays through Perch straight away."
        },
        {
          "type": "text",
          "id": "detail",
          "label": "Small print",
          "info": "Optional one-liner under the text, shown in muted type."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Perch features",
      "blocks": [
        { "type": "feature" },
        { "type": "feature", "settings": { "icon": "bluetooth", "heading": "Bluetooth 5.4", "text": "Pair once for a stable connection from across the room." } },
        { "type": "feature", "settings": { "icon": "angle", "heading": "Adjustable stand", "text": "Folds out to 75 degrees and holds a phone or a tablet." } },
        { "type": "feature", "settings": { "icon": "light", "heading": "Ambient ring", "text": "A soft gradient light around the face. Switch it off when you want dark." } }
      ]
    }
  ]
}
{% endschema %}
